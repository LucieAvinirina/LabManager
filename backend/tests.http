Authorization: Bearer {{token}}

### ─── TEST 30 : Signaler un incident ────────────────────────
POST {{baseUrl}}/incidents
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_equipement": 1,
  "description": "L'écran du PC_01 ne s'allume plus depuis ce matin",
  "photo_url": null
}

